@model List<SellerRequest>
@{
    ViewData["Title"] = "Seller Requests";
}
<h2>Seller Requests</h2>

@if (!Model.Any())
{
    <p class="text-muted">No seller requests yet.</p>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>User</th><th>Business Name</th><th>Date</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.User?.FullName (@r.User?.Email)</td>
                    <td>@r.BusinessName</td>
                    <td>@r.RequestDate.ToShortDateString()</td>
                    <td>
                        @switch (r.Status)
                        {
                            case SellerRequestStatus.Pending:
                                <span class="badge bg-warning text-dark">Pending</span>
                                break;
                            case SellerRequestStatus.Approved:
                                <span class="badge bg-success">Approved</span>
                                break;
                            case SellerRequestStatus.Rejected:
                                <span class="badge bg-danger">Rejected</span>
                                break;
                        }
                    </td>
                    <td>
                        @if (r.Status == SellerRequestStatus.Pending)
                        {
                            <form asp-action="ApproveSeller" asp-route-id="@r.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                            </form>
                            <form asp-action="RejectSeller" asp-route-id="@r.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
