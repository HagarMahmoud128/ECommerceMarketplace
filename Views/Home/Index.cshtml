@model List<Product>
@{
    ViewData["Title"] = "Home";
}

<div class="p-5 mb-4 bg-light rounded-3">
    <h1 class="display-5 fw-bold">Welcome to the Marketplace</h1>
    <p class="col-md-8 fs-4">Browse products from many independent sellers, all in one place.</p>
    <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-lg">Shop Now</a>
</div>

<h3>Featured Products</h3>
<div class="row row-cols-1 row-cols-md-4 g-4">
    @foreach (var product in Model)
    {
        <div class="col">
            <div class="card h-100">
                <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://placehold.co/300x200?text=Product" : product.ImageUrl)" class="card-img-top" alt="@product.Name" />
                <div class="card-body">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="text-muted small mb-1">@product.Category?.Name</p>
                    <p class="card-text fw-bold">@product.Price.ToString("C")</p>
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">View</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <p class="text-muted mt-3">No products available yet.</p>
}
