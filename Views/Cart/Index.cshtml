@model List<CartItem>
@{
    ViewData["Title"] = "Your Cart";
}
<h2>Your Cart</h2>

@if (!Model.Any())
{
    <p>Your cart is empty. <a asp-controller="Products" asp-action="Index">Browse products</a></p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr><th>Product</th><th>Price</th><th>Quantity</th><th>Subtotal</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Product?.Name</td>
                    <td>@item.Product?.Price.ToString("C")</td>
                    <td style="width: 200px;">
                        <form asp-action="UpdateQuantity" method="post" class="d-flex gap-2">
                            <input type="hidden" name="cartItemId" value="@item.Id" />
                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.Product?.AvailableQuantity" class="form-control form-control-sm" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
                        </form>
                    </td>
                    <td>@((item.Product!.Price * item.Quantity).ToString("C"))</td>
                    <td>
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="cartItemId" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <h4>Total: @Model.Sum(i => i.Quantity * i.Product!.Price).ToString("C")</h4>
    <a asp-action="Checkout" class="btn btn-success">Proceed to Checkout</a>
}
